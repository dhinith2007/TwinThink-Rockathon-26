# ProcuraAI Backend Environment Configuration Template
PORT=8000
ENVIRONMENT=development

# OpenRouter LLM API Key (Optional — fallback deterministic NLP engine active if omitted)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Database Connection (Supabase PostgreSQL or fallback to local SQLite)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
