# Database Configuration
# Leave DATABASE_URL empty to use local SQLite (sqlite:///./procura.db)
# Or provide Supabase / PostgreSQL URI (e.g., postgresql://postgres:password@db.xxx.supabase.co:5432/postgres)
DATABASE_URL=

# Supabase Credentials (optional for direct Supabase REST/Auth, backend uses SQLAlchemy DATABASE_URL)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AI Provider Configuration
# Supported: openrouter, deterministic
AI_PROVIDER=openrouter
AI_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
